# Copy this file to .env and edit. NO secrets go here -
# API keys and tokens are stored with:  uv run fin secret set <name>
FIN_PLAID_ENV=sandbox
FIN_LOG_LEVEL=INFO
# SEC EDGAR requires a User-Agent that identifies you:
FIN_SEC_USER_AGENT="finintel your-email@example.com"
# Optional: where the database and logs live (default: C:\Users\<you>\.finintel)
# FIN_DATA_DIR=C:/Users/you/.finintel
